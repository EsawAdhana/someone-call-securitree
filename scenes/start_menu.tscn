[sub_resource type="GDScript" id="GDScript_start_menu"]
script/source = "extends Control

@onready var start_button = $UI/VBoxContainer/StartButton
@onready var quit_button = $UI/VBoxContainer/QuitButton
@onready var background_music = $BackgroundMusic
@onready var character_spawner = $CharacterSpawner

# Character spawning
var character_scene = preload(\"res://scenes/character.tscn\")
var characters = []
var spawn_timer: Timer
var max_characters = 4
var spawn_interval = 3.0

func _ready():
	# Start background music
	if background_music:
		background_music.play()
	
	# Connect buttons
	start_button.pressed.connect(_on_start_button_pressed)
	quit_button.pressed.connect(_on_quit_button_pressed)
	
	# Set up character spawning
	setup_character_spawning()
	
	print(\"Start Menu: Ready!\")

func setup_character_spawning():
	spawn_timer = Timer.new()
	spawn_timer.wait_time = spawn_interval
	spawn_timer.timeout.connect(_spawn_character)
	spawn_timer.autostart = true
	add_child(spawn_timer)
	
	# Spawn initial characters
	for i in range(2):
		_spawn_character()

func _spawn_character():
	if characters.size() >= max_characters:
		return
	
	var character = character_scene.instantiate()
	if not character:
		return
	
	# Set random character type
	character.character_type = 0 if randf() < 0.7 else 1
	
	# Generate random name
	var first_names = [\"Alex\", \"Taylor\", \"Jordan\", \"Casey\", \"Riley\", \"Morgan\"]
	var last_names = [\"Smith\", \"Johnson\", \"Williams\", \"Garcia\", \"Rodriguez\"]
	character.variant_name = first_names[randi() % first_names.size()] + \" \" + last_names[randi() % last_names.size()]
	
	# Set random spawn position (off-screen, but only in bottom half)
	var viewport_size = get_viewport_rect().size
	var bottom_half_y_start = viewport_size.y * 0.5  # Middle of screen
	var spawn_side = randi() % 4  # 0=left, 1=top, 2=right, 3=bottom
	var spawn_pos = Vector2()
	var target_pos = Vector2()
	
	match spawn_side:
		0:  # Left side
			spawn_pos = Vector2(-100, randf_range(bottom_half_y_start, viewport_size.y - 100))
			target_pos = Vector2(randf_range(100, viewport_size.x - 100), randf_range(bottom_half_y_start + 50, viewport_size.y - 100))
		1:  # Top side (but only from middle of screen down)
			spawn_pos = Vector2(randf_range(100, viewport_size.x - 100), bottom_half_y_start - 100)
			target_pos = Vector2(randf_range(100, viewport_size.x - 100), randf_range(bottom_half_y_start + 50, viewport_size.y - 100))
		2:  # Right side
			spawn_pos = Vector2(viewport_size.x + 100, randf_range(bottom_half_y_start, viewport_size.y - 100))
			target_pos = Vector2(randf_range(100, viewport_size.x - 100), randf_range(bottom_half_y_start + 50, viewport_size.y - 100))
		3:  # Bottom side
			spawn_pos = Vector2(randf_range(100, viewport_size.x - 100), viewport_size.y + 100)
			target_pos = Vector2(randf_range(100, viewport_size.x - 100), randf_range(bottom_half_y_start + 50, viewport_size.y - 100))
	
	character.global_position = spawn_pos
	character.target_position = target_pos
	
	# Connect exit signal to clean up
	character.character_exited.connect(_on_character_exited)
	
	# Add to scene and track
	add_child(character)
	characters.append(character)
	
	print(\"Start Menu: Spawned character at \", spawn_pos, \" targeting \", target_pos)

func _on_character_exited(character):
	if characters.has(character):
		characters.erase(character)
	print(\"Start Menu: Character exited\")

func _on_start_button_pressed():
	print(\"Start Menu: Start button pressed\")
	# Stop music
	if background_music:
		background_music.stop()
	
	# Change to main map scene
	get_tree().change_scene_to_file(\"res://scenes/main_map.tscn\")

func _on_quit_button_pressed():
	print(\"Start Menu: Quit button pressed\")
	get_tree().quit()
"

