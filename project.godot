; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Someone Call Securitree"
run/main_scene="res://scenes/main_map.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LocationManager="*res://scripts/location_manager.gd"
GameManager="*res://scripts/game_manager.gd"
GlobalCharacterManager="*res://scripts/global_character_manager.gd"
MoraleManager="*res://scripts/morale_manager.gd"
GlobalUI="*res://scenes/global_ui.tscn"

[display]

window/size/mode=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
